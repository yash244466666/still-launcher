{"repo": {"name": {"en-US": "Still Launcher"}, "description": {"en-US": "Signed releases of Still Launcher, an open-source text-first launcher for digital wellbeing."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "be3d18492255733709740e1a77fbd0895f69ccbe3823f91f7f7d551b3537abc8", "size": 805}}, "address": "https://yash244466666.github.io/still-launcher/repo", "timestamp": 1794660513000, "categories": {"Launcher": {"name": {"en-US": "Launcher"}}, "System": {"name": {"en-US": "System"}}}}, "packages": {"org.stilllauncher": {"metadata": {"added": 1794660510000, "categories": ["Launcher", "System"], "changelog": "https://github.com/yash244466666/still-launcher/blob/main/CHANGELOG.md", "issueTracker": "https://github.com/yash244466666/still-launcher/issues", "lastUpdated": 1794660513000, "license": "GPL-3.0-or-later", "sourceCode": "https://github.com/yash244466666/still-launcher", "webSite": "https://github.com/yash244466666/still-launcher", "screenshots": {"phone": {"en-US": [{"name": "/org.stilllauncher/en-US/phoneScreenshots/1.png", "sha256": "e46793cfae7842de3cf1e253ef716969ccfd0623f33060047969c926e3eab654", "size": 97663}, {"name": "/org.stilllauncher/en-US/phoneScreenshots/2.png", "sha256": "f110a48d6590468efd491f40c43923de11ac5e5dbb03448e4b8ca5475dd112f8", "size": 80153}, {"name": "/org.stilllauncher/en-US/phoneScreenshots/3.png", "sha256": "c253de0064faf843af06d66d3486ab241cc4380d71592c58ed5347c13ee4d8a7", "size": 180235}]}}, "authorName": "Still Launcher contributors", "name": {"en-US": "Still Launcher"}, "summary": {"en-US": "A text-first launcher for digital wellbeing"}, "description": {"en-US": "Still Launcher replaces the home-screen icon grid with a short list of names,\na clock and a small set of tools you switch on deliberately.\n\nFeatures include an alphabetical app list with a drag/tap index bar, a Recent\napps section, favourites and folders, timed app blocking, recurring focus\nschedules, daily app limits, a home-screen background-app shortcut, screen-time\nstatistics, themes and gesture settings.\n\nOptional focus tools use Android's usage-access, accessibility and notification\naccess. All data stays on the device. The app has no INTERNET permission, no\naccounts, no ads and no analytics.\n\nAccessibility is used only to detect the current foreground app and optional\nshort-video view IDs. Notification access is used only for the local allow-list\nfilter. Per-app grayscale additionally requires a one-time adb grant of\nWRITE_SECURE_SETTINGS and is entirely optional.\n\nThis repository is an independent clean-room project. It is not affiliated\nwith, endorsed by or derived from any commercial launcher."}, "icon": {"en-US": {"name": "/org.stilllauncher/en-US/icon_ipOF7GnrVjY8JrSVh_DQ8ZI63ax4Ph6I3xyzWfQEX3s=.png", "sha256": "8a9385ec69eb56363c26b49587f0d0f1923addac783e1e88df1cb359f4045f7b", "size": 2800}}, "preferredSigner": "af841912594162f29ea85a12b2bb8347c016a938fb31ccfa0fdc4e3812c35def"}, "versions": {"5f4960cb911dc5024fe31bfc3b3328c2a5763c75ec2a3ff39da979c514b5f296": {"added": 1794660513000, "file": {"name": "/still-launcher-0.3.3-release.apk", "sha256": "5f4960cb911dc5024fe31bfc3b3328c2a5763c75ec2a3ff39da979c514b5f296", "size": 2800096}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.3.3", "versionCode": 100303, "usesSdk": {"minSdkVersion": 32, "targetSdkVersion": 36}, "signer": {"sha256": ["af841912594162f29ea85a12b2bb8347c016a938fb31ccfa0fdc4e3812c35def"]}, "usesPermission": [{"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.WRITE_SECURE_SETTINGS"}, {"name": "or